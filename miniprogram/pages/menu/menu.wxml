<view class="page">
  <!-- 门店信息 -->
  <view class="store-card">
    <view class="store-name">{{storeName}}</view>
    <view class="store-time">营业时间 {{openTime}} - {{closeTime}}</view>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  </view>

  <view class="menu-body">
    <!-- 左侧分类 -->
    <scroll-view class="sidebar" scroll-y>
      <view wx:for="{{categories}}" wx:key="_id"
        class="cat-item {{activeCat===item._id?'active':''}}"
        data-id="{{item._id}}" bindtap="onCatTap">{{item.name}}</view>
    </scroll-view>

    <!-- 右侧菜品 -->
    <scroll-view class="dish-list" scroll-y>
      <view wx:for="{{catDishes}}" wx:key="_id" class="dish-card {{item.soldOut?'soldout-card':''}}" data-id="{{item._id}}" bindtap="onDishTap">
        <image wx:if="{{item.image}}" class="dish-img" src="{{item.image}}" mode="aspectFill"/>
        <view wx:else class="dish-img placeholder"></view>
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view wx:if="{{item.desc}}" class="muted dish-desc ellipsis">{{item.desc}}</view>
          <view wx:if="{{item.stock!=null}}" class="muted stock">库存 {{item.stock}}{{item.unit||'份'}}</view>
          <view wx:if="{{(item.specs&&item.specs.length)||(item.extras&&item.extras.length)}}" class="spec-tag">选规格/加料</view>
          <view class="between foot">
            <view class="price">
              <block wx:if="{{item.hasPromo}}">
                <text>¥{{item.salePrice}}</text>
                <text class="orig-price">¥{{item.price}}</text>
                <text class="promo-tag">{{item.promoTag}}</text>
              </block>
              <block wx:else>¥{{item.price}}</block>
            </view>
            <view class="stepper">
              <view wx:if="{{qtyMap[item._id]}}" class="step-btn" data-id="{{item._id}}" catchtap="onDec">−</view>
              <text wx:if="{{qtyMap[item._id]}}" class="qty">{{qtyMap[item._id]}}</text>
              <view class="step-btn plus" data-id="{{item._id}}" catchtap="onDishTap">＋</view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{!catDishes.length}}" class="empty muted">暂无菜品</view>
    </scroll-view>
  </view>

  <!-- 底部购物车条 -->
  <view class="cart-bar">
    <view class="cart-left" bindtap="goCart">
      <view wx:if="{{cartQty>0}}" class="cart-badge">{{cartQty}}</view>
      <text class="muted">购物车</text>
    </view>
    <view class="cart-amount"><text class="price">¥{{cartAmount}}</text></view>
    <button class="go-btn" disabled="{{cartQty<=0}}" bindtap="goCart">去结算</button>
  </view>

  <!-- 规格/加料弹层 -->
  <view wx:if="{{showPopup}}" class="mask" catchtap="closePopup"></view>
  <view wx:if="{{showPopup}}" class="popup">
    <view class="between pop-head">
      <view class="popup-name">{{curDish.name}}</view>
      <view class="popup-price price">
        <block wx:if="{{popupHasPromo}}">
          <text>¥{{popupSalePrice}}</text>
          <text class="orig-price">¥{{popupPrice}}</text>
          <text class="promo-tag">{{popupPromoTag}}</text>
        </block>
        <block wx:else>¥{{popupPrice}}</block>
      </view>
    </view>

    <view wx:if="{{curDish.specs&&curDish.specs.length}}" class="pop-sec">
      <view class="sec-title">规格</view>
      <view class="pill-row">
        <view wx:for="{{curDish.specs}}" wx:key="name"
          class="pill {{selSpecIdx===index?'picked':''}}"
          data-idx="{{index}}" bindtap="onSpecTap">{{item.name}} +¥{{item.price}}</view>
      </view>
    </view>

    <view wx:if="{{curDish.extras&&curDish.extras.length}}" class="pop-sec">
      <view class="sec-title">加料</view>
      <view class="pill-row">
        <view wx:for="{{curDish.extras}}" wx:key="name"
          class="pill {{extraSel&&extraSel[index]?'picked':''}}"
          data-idx="{{index}}" bindtap="onExtraTap">{{item.name}} +¥{{item.price}}</view>
      </view>
    </view>

    <view class="pop-sec">
      <view class="sec-title">数量</view>
      <view class="stepper">
        <view class="step-btn" data-mode="dec" catchtap="onPopupQty">−</view>
        <text class="qty">{{popupQty}}</text>
        <view class="step-btn plus" data-mode="inc" catchtap="onPopupQty">＋</view>
      </view>
    </view>

    <button class="btn-primary confirm-btn" bindtap="confirmAdd">加入购物车</button>
  </view>
</view>
