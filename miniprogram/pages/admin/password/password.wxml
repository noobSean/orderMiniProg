<!-- 管理后台：修改管理密码 -->
<view class="page form-page" wx:if="{{ready}}">
  <view class="card block">
    <view class="block-title">修改管理密码</view>
    <view class="hint muted">修改成功后，所有设备的管理登录都会失效，需要用新密码重新登录。</view>

    <view class="form-row">
      <text class="label">原密码<text class="req">*</text></text>
      <input class="input" password maxlength="32" placeholder="请输入原管理密码"
        value="{{oldPwd}}" data-key="oldPwd" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="label">新密码<text class="req">*</text></text>
      <input class="input" password maxlength="32" placeholder="6-32 位，不能含空格"
        value="{{newPwd}}" data-key="newPwd" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="label">确认密码<text class="req">*</text></text>
      <input class="input" password maxlength="32" placeholder="再次输入新密码"
        value="{{confirmPwd}}" data-key="confirmPwd" bindinput="onInput" />
    </view>

    <view class="pw-tip muted">密码以加盐哈希（scrypt）存储在云端，不会明文保存；忘记密码可由开发者在云函数环境变量重置。</view>
  </view>

  <view class="safe-bottom" />
  <view class="save-bar">
    <button class="btn-primary save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="onSubmit">{{saving ? '保存中…' : '确认修改'}}</button>
  </view>
</view>
