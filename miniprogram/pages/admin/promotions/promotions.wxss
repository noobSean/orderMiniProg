.form-page { padding-bottom: 180rpx; }

.block { margin-top: 0; }
.block-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.add-link { color: var(--primary); font-size: 26rpx; font-weight: 400; }

.form-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.form-row:last-child { border-bottom: none; }
.label { width: 170rpx; color: var(--text-weak); flex-shrink: 0; font-size: 27rpx; }
.req { color: var(--danger); }
.input { flex: 1; text-align: right; font-size: 28rpx; height: 72rpx; line-height: 72rpx; }

.scope-group { display: flex; gap: 30rpx; flex: 1; justify-content: flex-end; }
.scope-opt { font-size: 27rpx; display: flex; align-items: center; gap: 6rpx; }
.cat-box { padding: 12rpx 0 16rpx; border-bottom: 2rpx solid var(--line); }
.cat-opt { display: inline-flex; align-items: center; font-size: 26rpx; margin: 8rpx 20rpx 8rpx 0; }
.empty-tip { font-size: 25rpx; padding: 12rpx 0; }

.picker-view { font-size: 28rpx; margin-left: 16rpx; color: var(--primary); }

.tip { font-size: 24rpx; line-height: 1.6; margin: 16rpx 0; }
.save-btn { width: 100%; margin: 8rpx 0 0; }

.promo-item { padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }
.promo-item:last-child { border-bottom: none; }
.promo-name { font-size: 29rpx; font-weight: 600; }
.promo-state { font-size: 22rpx; border-radius: 6rpx; padding: 2rpx 12rpx; }
.promo-state.on { color: var(--success); background: rgba(7, 193, 96, 0.08); }
.promo-state.off { color: var(--text-weak); background: var(--bg); }
.promo-meta { font-size: 24rpx; margin-top: 8rpx; }
.promo-ops { display: flex; gap: 36rpx; margin-top: 14rpx; font-size: 25rpx; color: var(--primary); }
.op.danger { color: var(--danger); }
