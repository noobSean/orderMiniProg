<view class="page detail-page" wx:if="{{ready}}">
  <view wx:if="{{fetching}}" class="empty muted">加载中…</view>
  <block wx:elif="{{detail}}">
    <!-- 头部 -->
    <view class="card head">
      <view class="between">
        <view class="d-no">{{detail.orderNo}}</view>
        <view class="row head-tags">
          <view class="tag pay-tag {{detail.paymentUnpaid?'unpaid':'paid'}}">{{detail.paymentLabel}}</view>
          <view class="tag status-tag s-{{detail.statusClass}}">{{detail.statusLabel}}</view>
          <view class="tag type-tag">{{detail.typeLabel}}</view>
        </view>
      </view>
      <view class="row head-meta muted"><text>下单时间：{{detail.time}}</text></view>
    </view>

    <!-- 待收款提示（线下 POS 收款后手动标记） -->
    <view wx:if="{{detail.paymentUnpaid && detail.status!=='cancel'}}" class="card pay-card">
      <view class="pay-copy">
        <view class="pay-title">待收款</view>
        <view class="muted pay-desc">员工卡 POS 收款后，点右侧按钮标记</view>
      </view>
      <button class="btn-pay" bindtap="onPay">标记已收款</button>
    </view>

    <!-- 买家信息 -->
    <view class="card block">
      <view class="block-title">买家信息</view>
      <view class="kv"><text class="k">姓名</text><text class="v">{{detail.name || '—'}}</text></view>
      <view class="kv"><text class="k">工号</text><text class="v">{{detail.empNo || '—'}}</text></view>
      <view class="kv"><text class="k">部门</text><text class="v">{{detail.dept || '—'}}</text></view>
      <view class="kv"><text class="k">位置</text><text class="v">{{detail.location || '—'}}</text></view>
      <view class="kv" wx:if="{{detail.type==='delivery'}}"><text class="k">配送目标</text><text class="v">{{detail.target || '—'}}</text></view>
      <view class="kv" wx:else><text class="k">取餐号</text><text class="v">{{detail.pickupNo || '—'}}</text></view>
    </view>

    <!-- 菜品 -->
    <view class="card block">
      <view class="block-title">菜品明细</view>
      <view class="line-item" wx:for="{{detail.items}}" wx:key="_id">
        <view class="between">
          <text class="i-name ellipsis">{{item.name}}</text>
          <text class="i-price">¥{{item.lineTotal}}</text>
        </view>
        <view class="i-sub muted" wx:if="{{item.spec}}">做法：{{item.spec}}</view>
        <view class="i-sub muted" wx:if="{{item.extras.length}}">加料：<text wx:for="{{item.extras}}" wx:for-item="ex" wx:key="name">{{ex.name}}</text></view>
        <view class="i-sub muted">x{{item.qty}} · 单价 ¥{{item.price}}</view>
      </view>
      <view wx:if="{{detail.discountText}}" class="between total-row">
        <text class="muted">活动优惠</text>
        <text class="price">-¥{{detail.discountText}}</text>
      </view>
      <view wx:if="{{detail.originalTotalText}}" class="between total-row muted">
        <text>原价</text>
        <text>¥{{detail.originalTotalText}}</text>
      </view>
      <view class="between total-row">
        <text class="muted">合计</text>
        <text class="price total">¥{{detail.totalText}}</text>
      </view>
    </view>

    <!-- 备注 / 时间 -->
    <view class="card block">
      <view class="block-title">其他信息</view>
      <view class="kv"><text class="k">支付状态</text><text class="v">{{detail.paymentLabel}}</text></view>
      <view class="kv" wx:if="{{detail.paidAt}}"><text class="k">收款时间</text><text class="v">{{detail.paidAt}}</text></view>
      <view class="kv" wx:if="{{detail.pickedUpAt}}"><text class="k">取餐时间</text><text class="v">{{detail.pickedUpAt}}</text></view>
      <view class="kv"><text class="k">备注</text><text class="v">{{detail.note || '无'}}</text></view>
    </view>

    <!-- 状态历史 -->
    <view class="card block" wx:if="{{detail.history.length}}">
      <view class="block-title">状态历史</view>
      <view class="hist-item" wx:for="{{detail.history}}" wx:key="index">
        <view class="hist-dot"></view>
        <view class="hist-body">
          <view class="hist-text">{{item.text}}</view>
          <view class="hist-time muted">{{item.time}}</view>
        </view>
      </view>
    </view>

    <!-- 底部操作：唯一主流程按钮 + 次要的取消文字链 -->
    <view wx:if="{{primaryAction || canCancel}}" class="action-bar">
      <text wx:if="{{canCancel}}" class="cancel-link" bindtap="onCancel">取消订单</text>
      <button wx:if="{{primaryAction}}" class="act primary" data-status="{{primaryAction.key}}" bindtap="onAction">{{primaryAction.text}}</button>
    </view>
  </block>
  <view wx:else class="empty muted">未找到订单</view>
</view>
