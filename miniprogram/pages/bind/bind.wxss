/* 非 tabBar 页面：底部补安全区，键盘弹起时整页还能滚动 */
.page { padding: 30rpx 0;
  padding-bottom: calc(30rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }
.form { margin: 20rpx; }
.tip { font-size: 24rpx; margin-bottom: 16rpx; }
.field { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid var(--line); position: relative; }
.label { flex-shrink: 0; width: 160rpx; font-size: 28rpx; }
.input { flex: 1; min-width: 0; font-size: 28rpx; height: 96rpx; line-height: 96rpx; }
.arrow { flex-shrink: 0; margin-left: 12rpx; font-size: 34rpx; color: var(--text-weak); }
/* 科室名可能很长：限宽省略，避免把「›」箭头挤出屏幕 */
.picker-like { flex: 1; min-width: 0; margin-right: 12rpx; font-size: 28rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.picker-like.placeholder { color: var(--text-weak); }
.submit { margin-top: 40rpx; }

.relogin { margin-top: 32rpx; text-align: center; font-size: 24rpx; }
